{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@12.0.2",
  "name": "kofa-design-system",
  "description": "Shared Kofa foundations and web and Flutter design system packages.",
  "workspaces": [
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspace @kofa/web-design-system",
    "build:storybook": "npm run build:storybook --workspace @kofa/web-design-system",
    "changeset": "changeset",
    "dev": "npm run dev --workspace @kofa/web-design-system",
    "docs:build": "vite build --config vite.docs.config.ts",
    "docs:dev": "vite --config vite.docs.config.ts",
    "docs:preview": "vite preview --config vite.docs.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/web/src packages/web/.storybook packages/web/vite.config.ts docs vite.docs.config.ts",
    "test": "npm run test --workspace @kofa/web-design-system",
    "test:coverage": "npm run test:coverage --workspace @kofa/web-design-system",
    "test:watch": "npm run test:watch --workspace @kofa/web-design-system",
    "tokens:build": "node scripts/build-tokens.mjs && node scripts/build-flutter-tokens.mjs",
    "typecheck": "npm run typecheck --workspace @kofa/web-design-system && tsc --noEmit",
    "tokens:build:flutter": "node scripts/build-flutter-tokens.mjs",
    "tokens:build:web": "node scripts/build-tokens.mjs",
    "check:flutter": "cd packages/flutter && flutter pub get && flutter analyze && flutter test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "style-dictionary": "5.5.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0",
    "vitest": "4.1.11"
  }
}
